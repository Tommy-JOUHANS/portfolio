{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "aptPkgs": [
            "libglib2.0-0",
            "libpango-1.0-0",
            "libpangoft2-1.0-0",
            "libpangocairo-1.0-0",
            "libcairo2",
            "libgdk-pixbuf-2.0-0",
            "libharfbuzz0b",
            "libffi8",
            "shared-mime-info",
            "fonts-liberation",
            "fonts-dejavu-core"
          ]
        }
      }
    }
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
